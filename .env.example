# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://driftwatch:change-me@db:5432/driftwatch

# Use your Alpaca PAPER keys. Paper keys can read market data and news.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# SEC requires a descriptive User-Agent with a real contact email.
SEC_USER_AGENT="Your Name your-email@example.com"

# Optional: Slack incoming webhook for alerts.
SLACK_WEBHOOK_URL=

# Anthropic API key (console.anthropic.com). Set a monthly spend limit there.
ANTHROPIC_API_KEY=

# Telegram bot from @BotFather. Leave TELEGRAM_CHAT_ID blank at first: message your bot,
# and it will reply with the number to put here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
